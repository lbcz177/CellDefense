    sprite: {fileID: 21300078, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第1轮 · 守住核心"
    sprite: {fileID: 21300079, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
