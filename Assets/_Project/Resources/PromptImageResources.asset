  columns: 56
  cellSize: 18
  panel: {fileID: 21300000, guid: c05158746b0d46fe9974f63c289b3a5b, type: 3}
  enemyPanel: {fileID: 21300000, guid: 249688d65bb6485f9fccdfece8f594a1, type: 3}
  button: {fileID: 21300000, guid: d31673e0a16248429e476128fbdd980b, type: 3}
  selectedButton: {fileID: 21300000, guid: ee3465cb08d84e7c8c155c8e5c176a01, type: 3}
  phrases:
  - text: "跳过引导"
    sprite: {fileID: 21300000, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "知道了"
    sprite: {fileID: 21300001, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "可自由操作 · 引导不暂停战斗"
    sprite: {fileID: 21300002, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "选择高亮的近卫塔（25 ATP）。建议先建两座，让射程交叉覆盖敌人路线。"
    sprite: {fileID: 21300003, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "点击高亮空格，再选择近卫塔。先布置两座交叉火力；敌人到达核心会扣生命，归零失败。"
    sprite: {fileID: 21300004, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "点击高亮的入口按钮开始这一波。击杀获得 ATP，清场后再布置；战斗中也可以继续建造。"
    sprite: {fileID: 21300005, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "观察交叉火力。可用 ATP 补建近卫；右上可暂停或切换倍速。清场后进入下一轮。"
    sprite: {fileID: 21300006, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "壁垒拦敌，后排输出。留意壁垒生命，破裂后可在空位补建；清场后学习巨噬与升级。"
    sprite: {fileID: 21300007, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第2轮 · 补建壁垒"
    sprite: {fileID: 21300008, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第2轮 · 保护防线"
    sprite: {fileID: 21300009, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "壁垒需要30 ATP。可等待击杀收入，或点击已有塔确认出售；也可跳过引导继续战斗。"
    sprite: {fileID: 21300010, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "点击路线上的高亮格，选择纤维蛋白壁垒（30 ATP）。放在近卫射程内，让后排保护它。"
    sprite: {fileID: 21300011, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第2轮 · 壁垒如何承伤"
    sprite: {fileID: 21300012, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "壁垒有500生命，拦住所有经过它的敌人，不改变路线。敌人越多，破裂越快；破裂后可补建。"
    sprite: {fileID: 21300013, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第3轮 · 加入巨噬细胞"
    sprite: {fileID: 21300014, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "在高亮格选择巨噬细胞（25 ATP）。它能拦住两名敌人，也能吞噬低血量目标，之后消化3秒。"
    sprite: {fileID: 21300015, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第3轮 · 升级与调整"
    sprite: {fileID: 21300016, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "点击高亮细胞，再点升级：支付其建造价，伤害提高50%。出售需确认，只返还实付费用的一半。"
    sprite: {fileID: 21300017, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "末波有真菌Boss和孢子。用积累的ATP补足四座近卫，让交叉火力覆盖壁垒；巨噬不能吞噬Boss。"
    sprite: {fileID: 21300018, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第3轮 · 完成防守"
    sprite: {fileID: 21300019, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "清除最后一波全部敌人，核心存活即可胜利。根据战况补建、升级或出售；后续关卡可尝试抗原协作。"
    sprite: {fileID: 21300020, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "稍后升级"
    sprite: {fileID: 21300021, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "受伤时播散孢子，留出清扫火力。"
    sprite: {fileID: 21300022, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "为附近同伴补盾和治疗，兼顾两路压力。"
    sprite: {fileID: 21300023, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "复制小单位，变异后需要重新采样。"
    sprite: {fileID: 21300024, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "外壳减伤，标记配合吞噬；酸化能破壳。"
    sprite: {fileID: 21300025, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "移动很快，接力火力与减速更有效。"
    sprite: {fileID: 21300026, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "召唤单位也会伤害核心，需要及时清扫。"
    sprite: {fileID: 21300027, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "成群进入，注意覆盖不同入口。"
    sprite: {fileID: 21300028, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: " 即将进入"
    sprite: {fileID: 21300029, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "外壳已破"
    sprite: {fileID: 21300030, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "  抗原 A"
    sprite: {fileID: 21300031, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "  抗原 B"
    sprite: {fileID: 21300032, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "选择防御细胞"
    sprite: {fileID: 21300033, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "取消"
    sprite: {fileID: 21300034, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "取消（右键 / Esc）"
    sprite: {fileID: 21300035, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "未配置"
    sprite: {fileID: 21300036, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "承伤壁垒 · 拦截全部"
    sprite: {fileID: 21300037, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "出售"
    sprite: {fileID: 21300038, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "升级"
    sprite: {fileID: 21300039, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "确认出售"
    sprite: {fileID: 21300040, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "拦截  全部经过的敌人\n"
    sprite: {fileID: 21300041, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "升级  已满级\n"
    sprite: {fileID: 21300042, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "升级  暂未开放\n"
    sprite: {fileID: 21300043, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "（ATP不足）\n"
    sprite: {fileID: 21300044, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "已满级"
    sprite: {fileID: 21300045, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "暂未开放升级"
    sprite: {fileID: 21300046, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第一关  守住伤口"
    sprite: {fileID: 21300047, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第二关  集中清除"
    sprite: {fileID: 21300048, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第三关  认出敌人"
    sprite: {fileID: 21300049, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第四关  两侧告急"
    sprite: {fileID: 21300050, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第五关  感染加剧"
    sprite: {fileID: 21300051, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "选择关卡"
    sprite: {fileID: 21300052, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "退出请求已触发；独立运行时关闭游戏窗口。"
    sprite: {fileID: 21300053, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "选择地图，开始防守"
    sprite: {fileID: 21300054, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "返回"
    sprite: {fileID: 21300055, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "滑动浏览关卡 · 返回键关闭"
    sprite: {fileID: 21300056, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "Esc 返回主菜单"
    sprite: {fileID: 21300057, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "重甲芽孢杆菌\n外壳减伤，标记配合吞噬；酸化能破壳。"
    sprite: {fileID: 21300058, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "重甲芽孢杆菌"
    sprite: {fileID: 21300059, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "病原体\n成群进入，注意覆盖不同入口。"
    sprite: {fileID: 21300060, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "病原体"
    sprite: {fileID: 21300061, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "鞭毛双球菌\n移动很快，接力火力与减速更有效。"
    sprite: {fileID: 21300062, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "鞭毛双球菌"
    sprite: {fileID: 21300063, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "变异超级真菌 即将进入\n受伤时播散孢子，留出清扫火力。"
    sprite: {fileID: 21300064, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "变异超级真菌"
    sprite: {fileID: 21300065, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "真菌孢子\n召唤单位也会伤害核心，需要及时清扫。"
    sprite: {fileID: 21300066, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "真菌孢子"
    sprite: {fileID: 21300067, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "细菌生物膜核心 即将进入\n为附近同伴补盾和治疗，兼顾两路压力。"
    sprite: {fileID: 21300068, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "细菌生物膜核心"
    sprite: {fileID: 21300069, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "葡萄球菌群\n成群进入，注意覆盖不同入口。"
    sprite: {fileID: 21300070, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "葡萄球菌群"
    sprite: {fileID: 21300071, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "病毒母体 即将进入\n复制小单位，变异后需要重新采样。"
    sprite: {fileID: 21300072, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "病毒母体"
    sprite: {fileID: 21300073, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "病毒复制体\n召唤单位也会伤害核心，需要及时清扫。"
    sprite: {fileID: 21300074, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "病毒复制体"
    sprite: {fileID: 21300075, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第1波\n开始"
    sprite: {fileID: 21300076, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
  - text: "第1波\n提前开始"
    sprite: {fileID: 21300077, guid: b8f4ad944b6448a484ce440b814cb509, type: 3}
